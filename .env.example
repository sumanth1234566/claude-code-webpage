# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.

# Where new leads (quote requests and availability checks) are emailed.
LEAD_NOTIFY_EMAIL=sumanth.bandarupally@bellacode.com

# Optional: webhook that receives each lead as JSON (POST). Leave empty until you have the URL.
LEAD_WEBHOOK_URL=

# Email provider key from https://resend.com. Needed to send lead emails and the customer auto-reply.
RESEND_API_KEY=

# Sender address. gofiber.com must be verified in Resend (add the DNS records it gives you).
EMAIL_FROM=GoFIBER <no-reply@gofiber.com>

# Final site URL once the domain is decided (used for SEO links, sitemap, canonical URLs).
NEXT_PUBLIC_SITE_URL=

# Set to "true" to hide the site from search engines (recommended while it is a preview).
NEXT_PUBLIC_NOINDEX=true
